# StreamSentinel — Environment Configuration Template
# Copy this file to .env and populate with appropriate values for your environment.

# ─── MongoDB (Standalone or MongoDB Atlas mongodb+srv://) ────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=fraud_db

# ─── Redis (Local Host/Port or Cloud TLS rediss:// URL) ──────────────────────
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka Streaming ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── FastAPI Server (PORT injected by PaaS cloud hosts) ─────────────────────
PORT=8000
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0

# ─── CORS Allowed Origins (Comma-separated) ──────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Frontend Observability URLs ─────────────────────────────────────────────
VITE_GRAFANA_URL=http://localhost:3000
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_SWAGGER_URL=http://localhost:8000/docs

# ─── Application Environment ─────────────────────────────────────────────────
APPLICATION_ENV=development
